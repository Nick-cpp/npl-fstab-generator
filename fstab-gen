#!/bin/sh

set -eu

PREFIX="${1:-}"

if [ -n "$PREFIX" ]; then
    if [ ! -d "$PREFIX" ]; then
        echo "Error: Directory '$PREFIX' does not exist." >&2
        exit 1
    fi
    PREFIX=$(cd "$PREFIX" && pwd)
fi

get_uuid() {
    dev_path="$1"
    uuid=""

    if [ -d /dev/disk/by-uuid ]; then
        for link in /dev/disk/by-uuid/*; do
            if [ -L "$link" ]; then
                target=$(readlink -f "$link" 2>/dev/null || true)
                if [ "$target" = "$dev_path" ]; then
                    uuid="${link##*/}"
                    break
                fi
            fi
        done
    fi

    if [ -z "$uuid" ] && command -v blkid >/dev/null 2>&1; then
        uuid=$(blkid "$dev_path" 2>/dev/null | grep -o 'UUID="[^"]*"' | cut -d'"' -f2)
    fi

    echo "$uuid"
}

cat << 'EOF'
# <file system>                             <mount point>  <type>  <options>             <dump> <pass>
EOF

while read -r dev path type opts dump pass; do
    case "$type" in
        sysfs|proc|devtmpfs|devpts|tmpfs|cgroup*|pstore|bpf|tracefs|securityfs|fusectl|configfs|debugfs|mqueue|hugetlbfs|efivarfs|autofs|overlay|rootfs)
            continue
            ;;
    esac

    target_path=""

    if [ -n "$PREFIX" ]; then
        case "$path" in
            "$PREFIX"|"$PREFIX"/*)
                target_path="${path#"$PREFIX"}"
                [ -z "$target_path" ] && target_path="/"
                ;;
            *)
                continue
                ;;
        esac
    else
        target_path="$path"
    fi

    spec="$dev"
    if [ -b "$dev" ]; then
        uuid=$(get_uuid "$dev")
        if [ -n "$uuid" ]; then
            spec="UUID=$uuid"
        fi
    fi

    if [ "$target_path" = "/" ]; then
        dump_val=1
        pass_val=1
    elif [ -b "$dev" ]; then
        dump_val=1
        pass_val=2
    else
        dump_val=0
        pass_val=0
    fi

    printf "%-43s %-14s %-7s %-21s %-6d %d\n" "$spec" "$target_path" "$type" "$opts" "$dump_val" "$pass_val"

done < /proc/mounts

if [ -f /proc/swaps ]; then
    tail -n +2 /proc/swaps | while read -r dev type size used priority; do
        [ -z "$dev" ] && continue

        if [ -b "$dev" ]; then
            uuid=$(get_uuid "$dev")
            if [ -n "$uuid" ]; then
                spec="UUID=$uuid"
            else
                spec="$dev"
            fi
        else
            if [ -n "$PREFIX" ]; then
                case "$dev" in
                    "$PREFIX"/*)
                        spec="${dev#"$PREFIX"}"
                        ;;
                    *)
                        continue
                        ;;
                esac
            else
                spec="$dev"
            fi
        fi

        printf "%-43s %-14s %-7s %-21s %-6d %d\n" "$spec" "none" "swap" "defaults" 0 0
    done
fi
